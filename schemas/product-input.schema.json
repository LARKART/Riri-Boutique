{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ririboutique.com/schemas/product-input.schema.json",
  "title": "Riri Boutique Product Input",
  "description": "Hand-authored source-of-truth for one product to be imported. The pipeline reads this, applies spec transformations, and produces a Shopify-ready product.",
  "type": "object",
  "required": ["sourceCurrency", "sourcePrice", "productType", "isDress", "group", "colors", "sizes"],
  "additionalProperties": false,
  "properties": {
    "sourceCurrency": {
      "type": "string",
      "enum": ["CAD", "USD"],
      "description": "Currency of sourcePrice. Converted to store currency (CAD) before .95 rounding (spec 13)."
    },
    "sourcePrice": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Base price per variant before transformation. Overridable per variant."
    },
    "productType": {
      "type": "string",
      "description": "e.g. Dress, Two-Piece Set, Blouse, Coat, Jacket, Sandals (spec 6.3)."
    },
    "isDress": {
      "type": "boolean",
      "description": "Drives dress-vs-adaptive title format and taxonomy (spec 12, 6.1)."
    },
    "name": {
      "type": "string",
      "description": "Invented brand-style name after the pipe (spec 5.2). If omitted, generated by the content module."
    },
    "productCode": {
      "type": "string",
      "description": "SKU PRODUCTCODE segment (spec 8). If omitted, derived from name."
    },
    "group": {
      "type": "string",
      "description": "Collection theme, e.g. 'Wedding Guest Dresses' (spec 11)."
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "description": "Only include attributes that are truly present (spec 5.1 'do not pad').",
      "properties": {
        "neckline": { "type": ["string", "null"] },
        "silhouette": { "type": ["string", "null"] },
        "occasion": {
          "type": ["string", "null"],
          "description": "Exactly ONE occasion keyword (spec 5.1)."
        },
        "length": { "type": ["string", "null"], "enum": ["Maxi", "Midi", "Mini", null] },
        "sleeve": { "type": ["string", "null"] },
        "material": { "type": ["string", "null"] }
      }
    },
    "colors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Customer-facing color option values (spec 3)."
    },
    "sizes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Customer-facing size option values (spec 3)."
    },
    "variantOverrides": {
      "type": "array",
      "description": "Optional per color+size price overrides.",
      "items": {
        "type": "object",
        "required": ["color", "size", "sourcePrice"],
        "additionalProperties": false,
        "properties": {
          "color": { "type": "string" },
          "size": { "type": "string" },
          "sourcePrice": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "images": {
      "type": "array",
      "description": "Approved supplier-origin image URLs only (spec 9.3, 17).",
      "items": {
        "type": "object",
        "required": ["src"],
        "additionalProperties": false,
        "properties": {
          "src": { "type": "string", "format": "uri" },
          "color": { "type": ["string", "null"], "description": "Color this image maps to; null = generic gallery image." },
          "position": { "type": "integer", "minimum": 1, "description": "Gallery order to preserve (spec 9.1)." },
          "main": { "type": "boolean", "description": "Marks the default/main image." }
        }
      }
    },
    "referenceUrl": {
      "type": "string",
      "format": "uri",
      "description": "Competitor/reference URL used for STRUCTURE ONLY — never content/images (spec 4, 17)."
    },
    "descriptionInput": {
      "type": "object",
      "description": "Optional factual hints fed to the Claude content module; never competitor copy (spec 10).",
      "additionalProperties": true
    }
  }
}

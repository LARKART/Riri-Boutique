{
  "name": "advisor-leads",
  "version": "1.0.0",
  "description": "US financial advisor YouTube lead database pipeline (free APIs only)",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "seed": "env -u APIFY_API_TOKEN node --env-file=.env src/stage0-seed.js",
    "match": "env -u APIFY_API_TOKEN node --env-file=.env src/stage1-match.js",
    "discover": "env -u APIFY_API_TOKEN node --env-file=.env src/stage1-discover.js",
    "enrich": "env -u APIFY_API_TOKEN node --env-file=.env src/stage2-enrich.js",
    "finalize": "env -u APIFY_API_TOKEN node --env-file=.env src/stage3-finalize.js",
    "export": "env -u APIFY_API_TOKEN node --env-file=.env src/stage4-export.js",
    "pipeline": "env -u APIFY_API_TOKEN node --env-file=.env src/pipeline.js"
  }
}

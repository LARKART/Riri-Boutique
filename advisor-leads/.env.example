# YouTube Data API v3 key (free): https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" on the project. Free quota: 10,000 units/day.
YOUTUBE_API_KEY=

# Optional overrides
MAX_SEARCH_PAGES_PER_QUERY=3        # 100 units per search page; budget carefully
SUBSCRIBER_MIN=1
SUBSCRIBER_MAX=25000
RECENCY_DAYS=60

# Stage 3 gap enrichment — primary: Apify Leads Finder ($1.5/1k leads)
APIFY_API_TOKEN=
# Actor ID from the actor's Apify store page, format: username~actor-name
APIFY_LEADS_ACTOR_ID=
# Stop enriching after this many leads pulled in a calendar month (cost guard;
# 5000 leads ≈ $7.50)
APIFY_MONTHLY_LEAD_BUDGET=5000

# Fallbacks (used only if the matching key is set)
APOLLO_API_KEY=
HUNTER_API_KEY=
HUNTER_MONTHLY_BUDGET=25

# Apollo monthly credit budget (free tier ~10k/mo)
APOLLO_MONTHLY_BUDGET=10000

# Google Sheets sync (optional; see src/sheets.js for setup)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
GOOGLE_SHEET_TAB=Leads

# YouTube channel About-page email scraper actor (Stage 2 pre-pass)
APIFY_YT_EMAIL_ACTOR_ID=

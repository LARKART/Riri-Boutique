# Copy to .env and fill in. .env is gitignored — never commit real values.

# Your store domain (no https://, no trailing slash)
SHOPIFY_STORE_DOMAIN=zd7csp-i7.myshopify.com

# Admin API access token (starts with shpat_).
# Get it from: Shopify admin -> Settings -> Apps and sales channels ->
# Develop apps -> <your app> -> API credentials -> Admin API access token.
# This is NOT the client secret (shpss_).
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin API version to test against.
SHOPIFY_API_VERSION=2025-01

# Store-data protection guard: the expected myshopify domain. The pipeline
# refuses to mutate any store whose myshopifyDomain != this value.
SHOPIFY_EXPECTED_MYSHOPIFY_DOMAIN=zd7csp-i7.myshopify.com

# Claude API key for the AI content module (titles' invented names + descriptions).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Apify (Stage 0 scraper). Token is secret; actor ID is the Shopify scraper actor.
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APIFY_SHOPIFY_ACTOR_ID=xxxxxxxxxxxxxxxxx

# Currency (spec 13): FX rate applied to non-CAD source prices BEFORE .95 rounding.
# FX_USD_CAD = CAD per 1 USD (confirm the current rate). PRICE_MARKUP e.g. 0.15 = +15%.
FX_USD_CAD=1.38
PRICE_MARKUP=0
